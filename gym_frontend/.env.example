# Frontend environment variables (Create React App)

# Base URL for API client calls (optional; defaults to /api). Example: http://localhost:8080/api
REACT_APP_API_BASE_URL=

# Backend base URL for OAuth redirects (optional; defaults to http://localhost:8080)
REACT_APP_BACKEND_URL=http://localhost:8080

# Optional Google Client ID (not required for redirect-only flow)
REACT_APP_GOOGLE_CLIENT_ID=

# Optional redirect URI (used only by mock/SDK flows; not required for redirect-only)
REACT_APP_GOOGLE_REDIRECT_URI=

# Feature flags
REACT_APP_FEATURE_USE_MOCKS=true
REACT_APP_FEATURE_GOOGLE_AUTH_SDK=false

# App name (optional)
REACT_APP_APP_NAME=Gym Manager
